APP_NAME=AnalyticCastle
APP_ENV=local
DEBUG=true

# Local development only. Tests use this same fallback if DATABASE_URL is unset.
# Use the SQLAlchemy psycopg URL form. Supabase example:
# DATABASE_URL=postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://analyticcastle:analyticcastle@127.0.0.1:5432/analyticcastle

# Generate a long random value for production. Do not commit real secrets.
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email delivery: console (log only) or smtp
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@analyticcastle.local
EMAIL_FROM_NAME=AnalyticCastle
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Required only when EMAIL_PROVIDER=smtp. Never commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30

# Comma-separated browser origins. Do not use * when credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-Request-ID

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_PASSWORD_RESET=5/minute
RATE_LIMIT_VERIFY_EMAIL_SEND=5/minute
RATE_LIMIT_CHANGE_PASSWORD=5/minute
RATE_LIMIT_TEST_CONNECTION=10/minute
RATE_LIMIT_METADATA_SEARCH=30/minute
RATE_LIMIT_METADATA_SYNC=5/minute
RATE_LIMIT_SAMPLE_DATA=10/minute
RATE_LIMIT_AI_CHAT=10/minute
RATE_LIMIT_MCP_QUERY=10/minute
RATE_LIMIT_MCP_SAMPLE=10/minute
RATE_LIMIT_MCP_METADATA=30/minute
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60

SECURITY_HEADERS_ENABLED=true
MAX_REQUEST_BODY_BYTES=1048576
TRUST_PROXY_HEADERS=false
HEALTH_CHECK_TIMEOUT_SECONDS=2
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_DISCOVERY_TIMEOUT=30
METADATA_DISCOVERY_MAX_SCHEMAS=100
METADATA_DISCOVERY_MAX_TABLES=2000
METADATA_DISCOVERY_MAX_COLUMNS=20000
METADATA_DISCOVERY_MAX_RELATIONSHIPS=5000
METADATA_SEARCH_DEFAULT_LIMIT=50
METADATA_SEARCH_MAX_LIMIT=100
METADATA_SEARCH_MAX_QUERY_LENGTH=255
METADATA_API_DEFAULT_PAGE_SIZE=50
METADATA_API_MAX_PAGE_SIZE=100
SAMPLE_DATA_DEFAULT_LIMIT=10
SAMPLE_DATA_MAX_LIMIT=100
SAMPLE_DATA_MAX_COLUMNS=100
SAMPLE_DATA_MAX_VALUE_CHARS=1024
SAMPLE_DATA_MAX_JSON_CHARS=4096
MCP_QUERY_DEFAULT_LIMIT=100
MCP_QUERY_MAX_LIMIT=1000
MCP_QUERY_TIMEOUT_SECONDS=30
MCP_QUERY_MAX_SQL_CHARS=10000
MCP_QUERY_MAX_RESULT_CHARS=262144
MCP_QUERY_MAX_VALUE_CHARS=1024
MCP_QUERY_MAX_JSON_CHARS=4096

# AES-256 key used to encrypt customer data-source passwords.
# Generate a 32-byte development key (do not commit the result):
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be independent from JWT_SECRET_KEY and DATABASE_URL.
DATA_SOURCE_ENCRYPTION_KEY=

# LLM provider for the AI analyst foundation. Never commit a real API key.
# LLM_PROVIDER=openai, openrouter, or openai_compatible
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_CONTEXT_CHARS=8000
AI_MAX_OUTPUT_CHARS=8000
AI_METADATA_SEARCH_LIMIT=10
AI_METADATA_RESOLVE_SEARCH_LIMIT=50
AI_MAX_METADATA_TABLES=20
AI_MAX_METADATA_COLUMNS=50
AI_MAX_METADATA_RELATIONSHIPS=30
AI_MAX_RESULT_LIMIT=100
AI_MAX_PLAN_METRICS=10
AI_MAX_PLAN_DIMENSIONS=10
AI_MAX_PLAN_FILTERS=20
AI_MAX_FILTER_VALUES=25
AI_MAX_CONCEPT_CHARS=128
